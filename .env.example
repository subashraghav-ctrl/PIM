# Database
DATABASE_URL=postgresql://pim_user:pim_pass@localhost:5432/pim_db

# Security — generate with: python scripts/generate_secret.py
SECRET_KEY=changeme_at_least_32_characters_long_please
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MFA
MFA_ISSUER_NAME=PIM-System

# Admin UI session cookie — separate secret
ADMIN_SESSION_SECRET=changeme_admin_session_secret_32chars

# Application
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# Scheduler
JIT_EXPIRY_CHECK_INTERVAL_MINUTES=5
AUDIT_LOG_RETENTION_DAYS=365

# Notifications (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=noreply@pim.internal
